# Foundry project endpoint (Foundry portal > project Overview > "Project endpoint")
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>

# Agent created in Foundry
FOUNDRY_AGENT_NAME=<your-agent-name>
FOUNDRY_AGENT_VERSION=1

# API key (Foundry portal > project Overview > API key). Put the real value in .env.local.
# Leave empty to authenticate with Entra ID instead (az login / managed identity).
FOUNDRY_API_KEY=

# Optional: override the OpenAI-compatible base URL (default: <project endpoint>/openai/v1)
# FOUNDRY_OPENAI_BASE_URL=
