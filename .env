# Foundry project endpoint (Foundry portal > project Overview > "Project endpoint")
FOUNDRY_PROJECT_ENDPOINT=https://ai-foundry-resource-5885.services.ai.azure.com/api/projects/ai-foundry-ryder

# Agent created in Foundry
FOUNDRY_AGENT_NAME=ryder-policy-bot
FOUNDRY_AGENT_VERSION=4

# API key: put the real value in .env.local (git-ignored), which overrides this file.
#   FOUNDRY_API_KEY=<your key>
# Leave it unset everywhere to authenticate with Entra ID instead (az login / managed identity).
FOUNDRY_API_KEY=

# Optional: override the OpenAI-compatible base URL (default: <project endpoint>/openai/v1)
# FOUNDRY_OPENAI_BASE_URL=
